{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drum-toolchain.local/contracts/schemas/rig-project/v1",
  "title": "Rig project v1",
  "type": "object",
  "required": ["schema_version", "kind", "project", "rig", "deployment", "ddrum4_output_channel", "sources", "connection_profiles", "source_decoders", "physical_events", "state", "logical_control_protocol", "logical_routes", "renderers", "native_control_map", "policies"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "rig-project"},
    "project": {"$ref": "#/$defs/id"},
    "rig": {"type": "string", "minLength": 1},
    "deployment": {"enum": ["simulation", "live"]},
    "ddrum4_output_channel": {"$ref": "#/$defs/channel"},
    "control_bus": {"$ref": "#/$defs/controlBus"},
    "ddrum4_bank": {"$ref": "#/$defs/ddrum4BankReference"},
    "sources": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/source"}},
    "connection_profiles": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/connectionProfile"}},
    "source_decoders": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decoder"}},
    "expression_routing": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/expressionRoute"}},
    "physical_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "state": {"$ref": "#/$defs/state"},
    "logical_control_protocol": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/control"}},
    "logical_routes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/logicalRoute"}}},
    "renderers": {"type": "object", "required": ["ddrum4", "sd3", "drumgizmo"], "additionalProperties": false, "properties": {"ddrum4": {"$ref": "#/$defs/ddrum4Renderer"}, "sd3": {"$ref": "#/$defs/sd3Renderer"}, "drumgizmo": {"$ref": "#/$defs/drumgizmoRenderer"}}},
    "native_control_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nativeControl"}},
    "ddrum_state_actions": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/ddrumStateAction"}}},
    "policies": {"$ref": "#/$defs/policies"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "channel": {"type": "integer", "minimum": 1, "maximum": 16},
    "byte": {"type": "integer", "minimum": 0, "maximum": 127},
    "source": {"type": "object", "required": ["endpoint", "channel", "primary"], "additionalProperties": false, "properties": {"endpoint": {"type": "string", "minLength": 1}, "channel": {"$ref": "#/$defs/channel"}, "primary": {"type": "string", "enum": ["usb", "din_bus", "din"]}, "connection_profile": {"$ref": "#/$defs/id"}}},
    "controlBus": {"type": "object", "required": ["endpoint", "channel", "status"], "additionalProperties": false, "properties": {"endpoint": {"type": "string", "minLength": 1}, "channel": {"enum": [14, 15]}, "status": {"enum": ["user-confirmed", "planned"]}}},
    "ddrum4BankReference": {"type": "object", "required": ["manifest"], "additionalProperties": false, "properties": {"manifest": {"type": "string", "minLength": 1}, "bank_id": {"$ref": "#/$defs/id"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "reports": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "connectionProfile": {"type": "object", "additionalProperties": false, "properties": {"deduplicate_din_copies": {"type": "boolean"}, "usb_sources": {"type": "boolean"}, "din_sources": {"type": "boolean"}}},
    "decoder": {"type": "object", "required": ["match", "emit"], "additionalProperties": false, "properties": {"match": {"$ref": "#/$defs/match"}, "emit": {"$ref": "#/$defs/emit"}}},
    "match": {"type": "object", "required": ["source", "type"], "additionalProperties": false, "properties": {"source": {"$ref": "#/$defs/id"}, "type": {"enum": ["note", "note_range", "cc", "poly_aftertouch"]}, "note": {"$ref": "#/$defs/byte"}, "note_range": {"type": "array", "items": {"$ref": "#/$defs/byte"}, "minItems": 2, "maxItems": 2}, "cc": {"$ref": "#/$defs/byte"}, "active_note": {"type": "boolean"}}},
    "emit": {"type": "object", "required": ["physical"], "additionalProperties": false, "properties": {"physical": {"$ref": "#/$defs/id"}, "expressions": {"type": "array", "uniqueItems": true, "items": {"enum": ["velocity", "position", "openness", "pressure"]}}, "normalize": {"enum": ["cc7"]}, "correlate": {"enum": ["source_channel_note"]}}},
    "state": {"type": "object", "required": ["scenes", "variables", "defaults"], "additionalProperties": false, "properties": {"scenes": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "variables": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "defaults": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 127}, "properties": {"scene": {"$ref": "#/$defs/id"}}}}},
    "control": {"type": "object", "required": ["channels", "type"], "additionalProperties": false, "properties": {"channels": {"const": [14, 15]}, "type": {"enum": ["program_change", "cc"]}, "cc": {"$ref": "#/$defs/byte"}}},
    "logicalRoute": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/logicalRouteVariant"}}]},
    "logicalRouteVariant": {"type": "object", "required": ["logical_target"], "additionalProperties": false, "properties": {"logical_target": {"$ref": "#/$defs/id"}, "when": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/byte"}}}},
    "ddrum4Renderer": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "required": ["note"], "additionalProperties": false, "properties": {"note": {"$ref": "#/$defs/byte"}, "position_policy": {"type": "string", "minLength": 1}}}},
    "sd3Renderer": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "required": ["note"], "additionalProperties": false, "properties": {"note": {"$ref": "#/$defs/byte"}, "channel": {"$ref": "#/$defs/channel"}, "cc": {"$ref": "#/$defs/byte"}, "position_cc": {"$ref": "#/$defs/byte"}}}},
    "expressionRoute": {"type": "object", "required": ["source", "physical", "expression", "correlation", "targets"], "additionalProperties": false, "properties": {"source": {"$ref": "#/$defs/id"}, "physical": {"$ref": "#/$defs/id"}, "expression": {"enum": ["openness", "pressure", "position"]}, "correlation": {"enum": ["none", "source_channel_note"]}, "targets": {"type": "object", "required": ["ddrum4", "sd3", "drumgizmo"], "additionalProperties": false, "properties": {"ddrum4": {"$ref": "#/$defs/expressionTarget"}, "sd3": {"$ref": "#/$defs/expressionTarget"}, "drumgizmo": {"$ref": "#/$defs/expressionTarget"}}}}},
    "expressionTarget": {"type": "object", "required": ["status", "event"], "additionalProperties": false, "properties": {"status": {"enum": ["measured", "user-confirmed", "planned", "unsupported"]}, "reason": {"type": "string", "minLength": 1}, "event": {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {"type": {"enum": ["cc", "poly_aftertouch", "quantized_note_p", "unsupported"]}, "channel": {"$ref": "#/$defs/channel"}, "cc": {"$ref": "#/$defs/byte"}, "transform": {"enum": ["passthrough"]}, "note_from": {"enum": ["active_rendered_hit"]}}}}},
    "drumgizmoRenderer": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "required": ["note", "instrument", "articulation"], "additionalProperties": false, "properties": {"note": {"$ref": "#/$defs/byte"}, "channel": {"$ref": "#/$defs/channel"}, "instrument": {"$ref": "#/$defs/id"}, "articulation": {"$ref": "#/$defs/id"}}}},
    "nativeControl": {"type": "object", "required": ["decode_to", "channel", "type", "value"], "additionalProperties": false, "properties": {"decode_to": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"}, "channel": {"$ref": "#/$defs/channel"}, "type": {"enum": ["program_change", "cc", "note"]}, "program": {"$ref": "#/$defs/byte"}, "cc": {"$ref": "#/$defs/byte"}, "note": {"$ref": "#/$defs/byte"}, "value": {"$ref": "#/$defs/byte"}}},
    "ddrumStateAction": {"type": "object", "required": ["type", "status"], "additionalProperties": false, "properties": {"type": {"enum": ["program_change", "sysex"]}, "channel": {"$ref": "#/$defs/channel"}, "program": {"$ref": "#/$defs/byte"}, "data": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/byte"}}, "when": {"type": "object", "additionalProperties": {"$ref": "#/$defs/byte"}}, "status": {"enum": ["measured", "user-confirmed", "planned"]}, "description": {"type": "string", "minLength": 1}}},
    "policies": {"type": "object", "required": ["echo", "unknown_message"], "additionalProperties": false, "properties": {"echo": {"enum": ["measured_only", "disabled"]}, "unknown_message": {"enum": ["drop_and_count", "drop"]}}}
  }
}
